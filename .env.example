# Chalanee — environment overrides for docker-compose
#
# Copy this file to `.env` and edit values to override the defaults below.
# All variables are OPTIONAL — leave a line out and the default applies.
#
# Usage:
#   cp .env.example .env
#   # edit .env, set values
#   docker compose up --build
#
# Note: only the *host*-side port changes. The in-container ports
# (3000, 3001, 1025, 1080) are fixed because they're part of the
# inter-container DNS-resolved URLs (e.g., http://chalanee-scoreboard:3001).

# ---- Host port overrides ----
# Use these if a default port is already in use on your machine.

# Chalanee app (web UI + API). Default: 3000
# APP_PORT=3000

# Score board UI + API. Default: 3001
# SCOREBOARD_PORT=3001

# MailHog web UI (view captured emails). Default: 1080
# MAILHOG_UI_PORT=1080

# MailHog SMTP listener. Default: 1025
# Only relevant if you connect a non-containerized client to send mail.
# MAILHOG_SMTP_PORT=1025

# ---- Secrets / tokens ----

# JWT signing secret used by the app (capstone target). Defaults to a
# placeholder; change for fresh cohorts via flag rotation.
# JWT_SECRET=chalanee-not-actually-secret-shh

# Bearer token required to read /api/scoreboard/instructor on the
# score board. Change this for each cohort.
# INSTRUCTOR_TOKEN=instructor-default-change-me
