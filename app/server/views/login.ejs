<%- include('partials/header', { title: 'Log in · Chalanee' }) %>

<div style="max-width: 460px; margin: 24px auto;">
  <div class="ch-page-head" style="text-align:center; align-items:center;">
    <h1>Welcome back</h1>
    <p class="subtle">Sign in to access your vault.</p>
  </div>

  <div class="card">
    <form id="login-form" autocomplete="on">
      <label class="field">
        <span>Email</span>
        <input type="text" name="email" autocomplete="email" placeholder="you@example.com" required>
      </label>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
      </label>
      <button type="submit" class="btn-block">Log in</button>
    </form>

    <div id="login-status" class="muted" style="margin-top:16px; display:none; font-size:13.5px;"></div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:18px; font-size:13.5px;">
      <a href="/forgot-password" class="muted">Forgot password?</a>
      <a href="/register" class="muted">Need an account? Register →</a>
    </div>
  </div>

  <div class="alert alert-info" style="margin-top:8px;">
    <div>
      <strong>Tip.</strong> Try the pre-seeded accounts on the home page — e.g. <code>alice@test.com / Password1!</code>.
    </div>
  </div>
</div>

<script>
  document.getElementById('login-form')?.addEventListener('submit', function (e) {
    e.preventDefault();
    var data = Object.fromEntries(new FormData(e.target).entries());
    var box = document.getElementById('login-status');
    var btn = e.target.querySelector('button[type=submit]');
    box.style.display = '';
    box.classList.remove('error', 'success');
    box.classList.add('muted');
    box.textContent = 'Signing in...';
    if (btn) { btn.disabled = true; btn.dataset.origText = btn.textContent; btn.textContent = 'Signing in...'; }

    function release() {
      if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origText || 'Log in'; }
    }
    function show(kind, msg) {
      box.classList.remove('muted', 'error', 'success');
      box.classList.add(kind);
      box.textContent = msg;
    }

    fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
      .then(function (r) {
        return r.text().then(function (raw) {
          var body; try { body = JSON.parse(raw); } catch (_) { body = { error: raw || ('HTTP ' + r.status) }; }
          return { status: r.status, body: body };
        });
      })
      .then(function (r) {
        release();
        if (r.status === 200 && r.body.token) {
          localStorage.setItem('ch_token', r.body.token);
          var bits = [];
          ['flag_t01','flag_e02','flag_m03','flag_m08','cookie_advice']
            .forEach(function (k) { if (r.body[k]) bits.push(r.body[k]); });
          show('success', bits.length ? ('Signed in. ' + bits.join(' | ')) : 'Signed in. Redirecting...');
          setTimeout(function () { window.location = '/dashboard'; }, bits.length ? 1500 : 250);
        } else {
          var msg = (r.body && r.body.error) || 'Login failed.';
          show('error', 'HTTP ' + r.status + ' — ' + msg);
        }
      })
      .catch(function (err) {
        release();
        show('error', 'Network error: ' + ((err && err.message) || err));
        console.error('login fetch failed', err);
      });
  });
</script>

<%- include('partials/footer') %>
