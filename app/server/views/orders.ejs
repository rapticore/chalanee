<%- include('partials/header', { title: 'Plans &amp; orders · Chalanee' }) %>

<div class="ch-page-head">
  <h1>Plans &amp; orders</h1>
  <p class="subtle">Choose a plan, redeem a coupon, or view your order history.</p>
</div>

<div class="grid grid-3">
  <div class="card hover">
    <h3>Free</h3>
    <p class="muted">Personal use. Up to 100 notes.</p>
    <p style="font-size:1.6rem; font-weight:700; margin:8px 0;">$0<span class="muted" style="font-size:0.7em; font-weight:400;"> /mo</span></p>
    <button class="btn btn-secondary plan-order" data-plan="free">Stay on Free</button>
  </div>
  <div class="card hover" style="border-color: var(--primary);">
    <h3>Premium <span class="badge badge-primary">Recommended</span></h3>
    <p class="muted">Unlimited notes, sharing, and webhooks.</p>
    <p style="font-size:1.6rem; font-weight:700; margin:8px 0;">$9.99<span class="muted" style="font-size:0.7em; font-weight:400;"> /mo</span></p>
    <button class="plan-order" data-plan="premium">Order Premium</button>
  </div>
  <div class="card hover">
    <h3>Enterprise</h3>
    <p class="muted">Team management, audit logs, SSO.</p>
    <p style="font-size:1.6rem; font-weight:700; margin:8px 0;">$49.99<span class="muted" style="font-size:0.7em; font-weight:400;"> /mo</span></p>
    <button class="plan-order" data-plan="enterprise">Order Enterprise</button>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Redeem a coupon</h2>
  </div>
  <p class="card-sub">Try <code>WELCOME10</code> for 10% off.</p>
  <form id="coupon-form" style="display:flex; gap:8px; max-width:520px;">
    <input name="code" type="text" required placeholder="Coupon code" autocomplete="off">
    <button type="submit">Redeem</button>
  </form>
  <pre id="coupon-result" style="margin-top:12px; display:none;"></pre>
</div>

<div class="card">
  <div class="card-head">
    <h2>Order history</h2>
    <span class="badge"><%= orders.length %> orders</span>
  </div>
  <% if (orders && orders.length) { %>
    <table class="table">
      <thead><tr><th>#</th><th>Plan</th><th>Qty</th><th>Total</th><th>Status</th><th>When</th></tr></thead>
      <tbody>
        <% orders.forEach(function (o) { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><span class="badge badge-primary"><%= o.plan %></span></td>
            <td><%= o.quantity %></td>
            <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
            <td><span class="badge"><%= o.status %></span></td>
            <td class="muted"><%= o.created_at %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="muted">No orders yet.</p>
  <% } %>
</div>

<pre id="order-result" style="display:none; max-width:720px;"></pre>

<script>
  document.querySelectorAll('.plan-order').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var plan = btn.dataset.plan;
      var qty = prompt('Quantity?', '1');
      if (qty === null) return;
      fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan: plan, quantity: Number(qty) })
      }).then(function (r) { return r.json(); })
        .then(function (j) {
          var box = document.getElementById('order-result');
          box.style.display = '';
          box.textContent = JSON.stringify(j, null, 2);
          setTimeout(function () { location.reload(); }, 1200);
        });
    });
  });

  document.getElementById('coupon-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var data = Object.fromEntries(new FormData(e.target).entries());
    fetch('/api/coupons/redeem', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function (r) { return r.json(); })
      .then(function (j) {
        var box = document.getElementById('coupon-result');
        box.style.display = '';
        box.textContent = JSON.stringify(j, null, 2);
      });
  });
</script>

<%- include('partials/footer') %>
