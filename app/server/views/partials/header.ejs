<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= typeof title !== 'undefined' ? title : 'Chalanee' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Chalanee — your personal digital vault.">
  <link rel="stylesheet" href="/static/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%236366f1'/%3E%3Cpath d='M16 9a4 4 0 0 0-4 4v3h-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-1v-3a4 4 0 0 0-4-4zm-2 7v-3a2 2 0 1 1 4 0v3h-4z' fill='white'/%3E%3C/svg%3E">
  <script src="/static/js/main.js" defer></script>
</head>
<body>
  <header class="ch-header">
    <div class="ch-header-inner">
      <a href="/" class="ch-logo" aria-label="Chalanee home">
        <span class="ch-logo-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </span>
        <span>Chalanee</span>
        <span class="ch-logo-tag">vault</span>
      </a>
      <nav class="ch-nav" aria-label="Primary">
        <% if (typeof viewer !== 'undefined' && viewer) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/notes">Notes</a>
          <a href="/orders">Orders</a>
          <a href="/webhooks">Webhooks</a>
          <a href="/admin">Admin</a>
          <a href="/users/<%= viewer.id %>">
            <%= viewer.name || viewer.email %>
          </a>
          <a href="/logout" class="cta">Log out</a>
        <% } else { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/search?q=">Search</a>
          <a href="/admin">Admin</a>
          <a href="/register">Register</a>
          <a href="/login" class="cta">Log in</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="ch-main">
